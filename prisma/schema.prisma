generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(cuid())
  employeeCode          String?                @unique
  fullName              String
  email                 String                 @unique
  password              String
  department            String
  role                  UserRole               @default(EMPLOYEE)
  createdAt             DateTime               @default(now())
  leaveApplications     LeaveApplication[]
  leaveBalance          LeaveBalance?
  quarterlyEntitlements QuarterlyEntitlement[]

  @@map("users")
}

model LeaveType {
  id                    String                 @id @default(cuid())
  name                  String
  code                  String                 @unique
  annualQuota           Int                    @default(0)
  quarterlyQuota        Int                    @default(0)
  carryForwardAllowed   Boolean                @default(false)
  isActive              Boolean                @default(true)
  effectiveFrom         DateTime               @default(now())
  createdAt             DateTime               @default(now())
  applications          LeaveApplication[]
  quarterlyEntitlements QuarterlyEntitlement[]

  @@map("leave_types")
}

model LeaveApplication {
  id           String                   @id @default(cuid())
  userId       String
  leaveTypeId  String
  startDate    DateTime
  endDate      DateTime
  totalDays    Int
  reason       String
  status       LeaveStatus              @default(PENDING)
  adminRemarks String?
  appliedAt    DateTime                 @default(now())
  leaveType    LeaveType                @relation(fields: [leaveTypeId], references: [id])
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations  LeaveRequestAllocation[]

  @@index([userId])
  @@index([status])
  @@index([leaveTypeId])
  @@index([userId, startDate, endDate])
  @@map("leave_applications")
}

model LeaveBalance {
  id          String @id @default(cuid())
  userId      String @unique
  casualLeave Int    @default(0)
  sickLeave   Int    @default(0)


  workFromHome Int    @default(0)


  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("leave_balances")
}

model QuarterlyEntitlement {
  id               String                   @id @default(cuid())
  userId           String
  leaveTypeId      String
  year             Int
  quarter          Int
  allocatedDays    Int
  usedDays         Int                      @default(0)
  reservedDays     Int                      @default(0)
  carryInDays      Int                      @default(0)
  carryOutDays     Int                      @default(0)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  leaveAllocations LeaveRequestAllocation[]
  leaveType        LeaveType                @relation(fields: [leaveTypeId], references: [id])
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, quarter, leaveTypeId])
  @@index([userId, year, quarter])
  @@index([leaveTypeId])
  @@map("quarterly_entitlements")
}

model LeaveRequestAllocation {
  id                     String               @id @default(cuid())
  leaveApplicationId     String
  quarterlyEntitlementId String
  allocatedDays          Int
  leaveApplication       LeaveApplication     @relation(fields: [leaveApplicationId], references: [id], onDelete: Cascade)
  entitlement            QuarterlyEntitlement @relation(fields: [quarterlyEntitlementId], references: [id])

  @@unique([leaveApplicationId, quarterlyEntitlementId])
  @@index([quarterlyEntitlementId])
  @@map("leave_request_allocations")
}
  model EmployeeCodeCounter {
  role  UserRole @id
  value Int      @default(0)

  @@map("employee_code_counters")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}
model AdminRegistrationRequest {
  id             String   @id @default(cuid())
  fullName       String
  email          String   @unique
  password       String
  department     String
  status         AdminRequestStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  adminRemarks   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@map("admin_registration_requests")
}

enum UserRole {
  EMPLOYEE
  ADMIN
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}
enum AdminRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model PublicHoliday {
  id          String   @id @default(cuid())
  name        String
  date        DateTime
  description String?
  createdAt   DateTime @default(now())

  @@index([date])
  @@map("public_holidays")
}
